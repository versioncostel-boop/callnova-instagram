# OpenAI
BOT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Gemini (preferred when a Gemini key is present)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (preferred: fast, conversational replies)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (set this to use NIM instead of OpenAI)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Meta / Instagram Messaging API
META_VERIFY_TOKEN=change-this-to-a-long-random-value
META_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v24.0

# Optional: receives each qualified lead as JSON via POST.
# Leave blank to retain leads in data/leads.json until a CRM is selected.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_BEARER_TOKEN=

# Optional: Gmail/SMTP notification for payment and receipt CRM updates.
EMAIL_NOTIFICATION_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=

# Payment details - keep these only in local .env and Render environment variables.
BANK_IBAN=
BANK_ACCOUNT_NAME=

PORT=3000
